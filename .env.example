# Choose one Vercel Blob authentication mode.

# Standard local/server credential (simplest handoff option):
BLOB_READ_WRITE_TOKEN=

# Alternative Vercel OIDC mode (both are required together):
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# Write lock (see WRITE-LOCK.md). Server-side only; never NEXT_PUBLIC_.
# "on" arms the lock. Anything else (or empty) leaves writes open as before,
# except that other websites can no longer write.
GOALS_WRITE_LOCK=
# Random string, at least 32 characters. Signs the sign-in cookie.
GOALS_SESSION_SECRET=
# The team PIN people type once per computer. At least 6 characters.
GOALS_TEAM_PIN=
# Named server keys for other apps: "name:key,name2:key2". Each key at least
# 24 characters. Sent as "Authorization: Bearer <key>".
GOALS_WRITE_KEYS=
